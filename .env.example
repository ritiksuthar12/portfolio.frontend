# API Base URL pointing to the backend Express server
# For Local Development:
VITE_API_URL=http://localhost:5000/api

# For Production (replace with your deployed backend URL on Render, Railway, or VPS):
# VITE_API_URL=https://your-api-domain.onrender.com/api

# EmailJS Configuration (Free at https://www.emailjs.com/)
# Allows visitors to send emails directly to ritiksuthar989@gmail.com
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
